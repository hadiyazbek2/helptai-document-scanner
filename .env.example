# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: several keys, comma-separated. When one runs out of quota the server uses the next.
# GEMINI_API_KEYS=key1,key2,key3
# PORT=8080        # API server port
# API_PORT=8080    # port the web dev server proxies /api to
# Comma-separated Gemini models, tried in order (busy or out-of-quota models are skipped)
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash
# How much Gemini may "think" before answering: minimal, low (default), medium, high, or default.
# GEMINI_THINKING=low
# Seconds-as-milliseconds before giving up on one Gemini attempt and trying the next model.
# GEMINI_TIMEOUT_MS=150000       # whole document
# GEMINI_PAGE_TIMEOUT_MS=90000   # one page (retake photo or frame from the video)
# Show the developer panel (model, key, time, tries) on the review screen. On by default in
# `npm run dev`, off in a production build unless set to true.
# VITE_SHOW_DEV_INFO=true
